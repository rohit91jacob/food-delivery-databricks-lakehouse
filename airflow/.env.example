# Copy to airflow/.env (git-ignored). Read by airflow/docker-compose.yaml.
AIRFLOW_UID=50000
AIRFLOW_PORT=8080
FERNET_KEY=
AIRFLOW__API_AUTH__JWT_SECRET=change-me
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Databricks connection: workspace URL + personal access token (JSON connection format).
AIRFLOW_CONN_DATABRICKS_DEFAULT={"conn_type": "databricks", "host": "https://<workspace>.cloud.databricks.com", "password": "<personal-access-token>"}

# Must match the bundle target you deployed (see `make bundle-env TARGET=dev`).
FD_CATALOG=workspace
FD_SCHEMA=fooddelivery
FD_GOLD_SCHEMA=fooddelivery_gold
FD_DATABRICKS_JOB_NAME=fooddelivery_daily
FD_START_DATE=2026-09-01
FD_SEED_SOURCE=kaggle
FD_ALERT_WEBHOOK_URL=
