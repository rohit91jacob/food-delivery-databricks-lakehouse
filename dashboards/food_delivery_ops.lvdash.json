{
  "datasets": [
    {
      "name": "kpis",
      "displayName": "Daily KPIs",
      "queryLines": [
        "SELECT business_date, city, orders_placed, orders_delivered, orders_cancelled, gmv, aov,\n",
        "       on_time_rate, cancellation_rate, contribution_margin, avg_delivery_minutes, refunds_amount\n",
        "FROM gold_daily_kpis\n"
      ]
    },
    {
      "name": "sla",
      "displayName": "Delivery SLA by hour",
      "queryLines": [
        "SELECT placed_hour, weather, city, delivered_orders, late_orders, p90_delivery_minutes, eta_mae_minutes\n",
        "FROM gold_delivery_sla_hourly\n"
      ]
    },
    {
      "name": "cancellations",
      "displayName": "Cancellations",
      "queryLines": [
        "SELECT business_date, city, cancellation_reason, cancelled_orders, gmv_lost FROM gold_cancellations_daily\n"
      ]
    },
    {
      "name": "riders",
      "displayName": "Rider utilisation",
      "queryLines": [
        "SELECT business_date, city, rider_id, deliveries, utilisation, earnings FROM gold_rider_daily\n",
        "WHERE shift_minutes > 0\n"
      ]
    },
    {
      "name": "dishes",
      "displayName": "Top dishes",
      "queryLines": [
        "SELECT week_start, city, item_name, quantity, revenue FROM gold_menu_popularity_weekly\n",
        "WHERE rank_in_city_week <= 5\n"
      ]
    }
  ],
  "pages": [
    {
      "name": "overview",
      "displayName": "Overview",
      "layout": [
        {
          "widget": {
            "name": "title",
            "textbox_spec": "# Food Delivery Operations\nGold marts from the `fooddelivery` Lakeflow pipeline. Business dates are in Asia/Kolkata."
