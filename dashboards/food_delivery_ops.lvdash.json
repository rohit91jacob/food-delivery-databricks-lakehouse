          "position": {
            "x": 0,
            "y": 0,
            "width": 6,
            "height": 2
          }
        },
        {
          "widget": {
            "name": "c_gmv",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "kpis",
                  "disaggregated": false,
                  "fields": [
                    {
                      "name": "sum(gmv)",
                      "expression": "SUM(`gmv`)"
                    }
                  ]
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "sum(gmv)",
                  "displayName": "GMV (INR)"
                }
