# Copy to .env (git-ignored) and adjust. Every variable is optional; defaults are shown.

# --- generator -------------------------------------------------------------
FD_SEED=42                        # RNG seed; same seed + date => byte-identical files
FD_START_DATE=2026-09-01          # day 0 (full dimension snapshot) and the DAG start date
FD_CITIES=Bangalore,Mumbai,Delhi,Hyderabad,Pune
FD_RESTAURANTS_PER_CITY=120
FD_BASE_ORDERS_PER_CITY=600       # before weekday/festival/weather/growth effects
FD_INITIAL_CUSTOMERS_PER_CITY=4000
FD_RIDERS_PER_100_ORDERS=18
FD_GPS_PING_SECONDS=120
FD_DUPLICATE_RATE=0.003           # exact duplicate order/event records (exercise dedupe)
FD_INVALID_RATE=0.002             # corrupt order records (exercise quarantine)

# --- seed ------------------------------------------------------------------
FD_SEED_SOURCE=kaggle             # kaggle | synthetic
FD_KAGGLE_TOKEN_FILE=             # optional: file holding a KGAT_ token (else ~/.kaggle/access_token or KAGGLE_API_TOKEN)
FD_DATA_DIR=data                  # local landing zone, seed and downloads

# --- lakehouse target (must match the deployed bundle target) -------------
FD_CATALOG=workspace
FD_SCHEMA=fooddelivery            # dev target: dev_<your_short_name>_fooddelivery
FD_GOLD_SCHEMA=                   # default <FD_SCHEMA>_gold
FD_VOLUME=landing
FD_DATABRICKS_JOB_NAME=fooddelivery_daily   # dev target: "[dev <your_short_name>] fooddelivery_daily"
FD_SQL_WAREHOUSE_NAME=Serverless Starter Warehouse
FD_DATABRICKS_CONN_ID=databricks_default

# --- ops -------------------------------------------------------------------
FD_ALERT_WEBHOOK_URL=             # optional Slack-compatible incoming webhook
FD_LOG_LEVEL=INFO
FD_LOG_FORMAT=json                # json | text

# --- local Spark (tests / fd local-run) ------------------------------------
FD_SPARK_MASTER=local[4]
FD_SPARK_DRIVER_MEMORY=2g
FD_SPARK_JARS=                    # optional comma-separated Delta jars for offline machines
